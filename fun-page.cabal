cabal-version:      3.0
name:               fun-page
version:            1.0.0
author:             Tomasz Maciosowski <t4ccer@gmail.com>
license:            AGPL-3.0-or-later
category:           Web
build-type:         Simple
extra-source-files: README.md

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    FunctionalDependencies
    GADTs
    LambdaCase
    LexicalNegation
    MultiWayIf
    NegativeLiterals
    NoStarIsType
    NumDecimals
    OverloadedStrings
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    RankNTypes
    RecordWildCards
    RoleAnnotations
    TypeFamilies
    TypeFamilyDependencies

  build-depends:      base >=4.9 && <5
  ghc-options:
    -Weverything -Werror -Wno-unused-do-bind -Wno-implicit-prelude
    -Wno-name-shadowing -Wno-unsafe -Wno-missing-safe-haskell-mode
    -Wno-missing-local-signatures -Wno-monomorphism-restriction
    -Wno-missed-specialisations -Wno-all-missed-specializations
    -Wno-unrecognised-pragmas -Wno-operator-whitespace
    -fprint-equality-relations -fprint-explicit-kinds
    -fprint-explicit-foralls -fno-show-error-context
    -fhide-source-paths

library
  import:          lang
  hs-source-dirs:  src

  -- cabal-fmt: expand src
  exposed-modules:
    FunPage.Html
    FunPage.Internal.Create
    FunPage.Internal.FFI
    FunPage.Internal.Html
    FunPage.Internal.Hydrate
    FunPage.Internal.HydrationKey
    FunPage.Internal.Monad
    FunPage.Internal.Reactive
    FunPage.Internal.Render
    FunPage.Reactive
    FunPage.Site

  build-depends:
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , transformers

library fun-page-tasty
  import:          lang
  visibility:      public
  hs-source-dirs:  fun-page-tasty
  exposed-modules: FunPage.Test
  build-depends:
    , fun-page
    , tasty
    , tasty-hunit
    , text

test-suite fun-page-test
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Test.hs
  build-depends:
    , fun-page
    , fun-page-tasty
    , tasty
    , tasty-hunit
    , text

executable example-counter
  import:         lang
  hs-source-dirs: examples
  main-is:        Counter.hs
  build-depends:
    , fun-page
    , text

executable todo-mvc
  import:         lang
  hs-source-dirs: examples
  main-is:        TodoMVC.hs
  build-depends:
    , fun-page
    , text

executable fetch-user
  import:         lang
  hs-source-dirs: examples
  main-is:        FetchUser.hs
  build-depends:
    , fun-page
    , text

executable dice
  import:         lang
  hs-source-dirs: examples
  main-is:        Dice.hs
  build-depends:
    , fun-page
    , text
