cabal-version:      3.0
name:               fun-page
version:            1.0.0
author:             Tomasz Maciosowski <t4ccer@gmail.com>
license:            AGPL-3.0-or-later
category:           Web
build-type:         Simple
extra-source-files: README.md

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    FunctionalDependencies
    GADTs
    LambdaCase
    LexicalNegation
    MultiWayIf
    NegativeLiterals
    NoStarIsType
    NumDecimals
    OverloadedStrings
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    RankNTypes
    RecordWildCards
    RoleAnnotations
    TypeFamilies
    TypeFamilyDependencies

  build-depends:      base >=4.9 && <5
  ghc-options:
    -Weverything -Werror -Wno-unused-do-bind -Wno-implicit-prelude
    -Wno-name-shadowing -Wno-unsafe -Wno-missing-safe-haskell-mode
    -Wno-missing-local-signatures -Wno-monomorphism-restriction
    -Wno-missed-specialisations -Wno-all-missed-specializations
    -Wno-unrecognised-pragmas -Wno-operator-whitespace
    -fprint-equality-relations -fprint-explicit-kinds
    -fprint-explicit-foralls -fno-show-error-context
    -fhide-source-paths

flag browser
  description:
    Build the MicroHs browser backend (needs emscripten). Ignored by GHC.

  default:     False
  manual:      True

library
  import:          lang
  hs-source-dirs:  src

  -- cabal-fmt: expand src -FunPage.Internal.FFI.JS -FunPage.Internal.FFI.MHS -FunPage.Internal.FFI.Stubs
  exposed-modules:
    FunPage.Html
    FunPage.Internal.Create
    FunPage.Internal.FFI
    FunPage.Internal.Html
    FunPage.Internal.Hydrate
    FunPage.Internal.HydrationKey
    FunPage.Internal.Monad
    FunPage.Internal.Reactive
    FunPage.Internal.Render
    FunPage.Internal.Stack
    FunPage.JS
    FunPage.Reactive
    FunPage.Site

  build-depends:
    , bytestring
    , containers
    , directory
    , process
    , text
    , transformers

  -- The DOM primitives of one backend, re-exported by FunPage.Internal.FFI. Under MicroHs the
  -- browser backend (foreign import javascript) needs emscripten, so it is only built with the
  -- browser flag; otherwise there are stubs, as for native GHC.
  if arch(javascript)
    other-modules: FunPage.Internal.FFI.JS

  elif (impl(mhs) && flag(browser))
    other-modules: FunPage.Internal.FFI.MHS
    cpp-options:   -DFUN_PAGE_BROWSER

  else
    other-modules: FunPage.Internal.FFI.Stubs

library fun-page-tasty
  import:          lang
  visibility:      public
  hs-source-dirs:  fun-page-tasty
  exposed-modules: FunPage.Test
  build-depends:
    , fun-page
    , tasty
    , tasty-hunit
    , text

  -- jsdom/tasty test harness: GHC JavaScript backend only.
  if impl(mhs)
    buildable: False

test-suite fun-page-test
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Test.hs
  build-depends:
    , fun-page
    , fun-page-tasty
    , tasty
    , tasty-hunit
    , text

  -- jsdom/tasty test harness: GHC JavaScript backend only.
  if impl(mhs)
    buildable: False

executable example-counter
  import:         lang
  hs-source-dirs: examples
  main-is:        Counter.hs
  build-depends:
    , fun-page
    , text

  -- With the browser backend there are no native programs (mcabal builds natively).
  if (impl(mhs) && flag(browser))
    buildable: False

executable todo-mvc
  import:         lang
  hs-source-dirs: examples
  main-is:        TodoMVC.hs
  build-depends:
    , fun-page
    , text

  -- With the browser backend there are no native programs (mcabal builds natively).
  if (impl(mhs) && flag(browser))
    buildable: False

executable fetch-user
  import:         lang
  hs-source-dirs: examples
  main-is:        FetchUser.hs
  build-depends:
    , fun-page
    , text

  -- Uses GHC.JS.Prim (JSVal strings), which MicroHs does not have.
  if impl(mhs)
    buildable: False

executable dice
  import:         lang
  hs-source-dirs: examples
  main-is:        Dice.hs
  build-depends:
    , fun-page
    , text

  -- MicroHs compiles foreign import javascript only for emscripten, and mcabal builds natively.
  if (impl(mhs) && flag(browser))
    buildable: False

-- The playground (see fun-page-playground/README.md). Generating it also builds its compiler (MicroHs).
executable fun-page-playground
  import:         lang
  hs-source-dirs: fun-page-playground
  main-is:        FunPage/Playground.hs
  other-modules:
    FunPage.Playground.Browser
    FunPage.Playground.Build

  build-depends:
    , directory
    , fun-page
    , process
    , text

  -- Uses GHC.JS.Prim; it is built with GHC (the compiler it runs is MicroHs).
  if impl(mhs)
    buildable: False
